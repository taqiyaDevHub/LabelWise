# ---- Backend ----
# Vision classifier credentials. Set ONE of these (or both; Claude is
# preferred when both exist). Without either, the backend runs in
# keyword-only mode and /health reports vision_enabled=false.
#
# Gemini has a free tier: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Anthropic (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=

# LABELWISE_VISION_PROVIDER=auto        # auto | claude | gemini | off
# LABELWISE_GEMINI_MODEL=gemini-3.6-flash

# Optional overrides
# LABELWISE_VISION_MODEL=claude-opus-5
# LABELWISE_VISION_EFFORT=medium        # low | medium | high
# LABELWISE_VISION_TIMEOUT=45           # seconds
# LABELWISE_VISION_ENABLED=1            # set 0 to force keyword-only mode
# LABELWISE_CORS_ORIGINS=http://localhost:8501

# ---- Frontend ----
# LABELWISE_BACKEND_URL=http://localhost:8000
# LABELWISE_USE_MOCK=0                  # 1 = demo mode, no backend needed
