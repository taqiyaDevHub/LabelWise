# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud -> App -> Settings -> Secrets.
# app.py mirrors these into environment variables at startup.

LABELWISE_ANALYSIS_MODE = "local"   # run the pipeline in-process (no backend server)
GEMINI_API_KEY = "AIza..."          # free tier: https://aistudio.google.com
# ANTHROPIC_API_KEY = "sk-ant-..."  # optional; preferred over Gemini when both are set
